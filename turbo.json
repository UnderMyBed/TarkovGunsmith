{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "eslint.config.js",
    "tsconfig.base.json",
    ".prettierrc.json",
    ".prettierignore"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".wrangler/**"]
    },
    "@tarkov/web#build": {
      "dependsOn": ["^build"],
      "env": ["TARKOV_SNAPSHOT_SOURCE"],
      "inputs": ["$TURBO_DEFAULT$", "../../packages/tarkov-data/src/__fixtures__/*-sample.json"],
      "outputs": ["dist/**", "public/data/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@tarkov/repo-guards#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../.github/**",
        "../../mise.toml",
        "../../.nvmrc",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        "../../turbo.json"
      ],
      "outputs": ["coverage/**"]
    },
    "@tarkov/repo-guards#test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../.github/**",
        "../../mise.toml",
        "../../.nvmrc",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        "../../turbo.json"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
