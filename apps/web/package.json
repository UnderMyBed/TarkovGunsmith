{
  "name": "@tarkov/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TarkovGunsmith — Vite + React SPA. Cloudflare Pages.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "dev": "vite",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev",
    "pages:deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tarkov/ballistics": "workspace:*",
    "@tarkov/data": "workspace:*",
    "@tarkov/og": "workspace:^",
    "@tarkov/optimizer": "workspace:*",
    "@tarkov/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.45",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wrangler": "^4.150.0"
  }
}
