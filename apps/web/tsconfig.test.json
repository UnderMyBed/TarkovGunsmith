{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // No `@cloudflare/workers-types` here: it declares a global `Element` (HTMLRewriter's)
    // that collides with the DOM's, so `HTMLSelectElement` stops satisfying `HTMLElement`.
    // The Pages Function tests that need `PagesFunction` live in functions/tsconfig.test.json.
    "types": ["node", "react", "vite/client"],
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*", "scripts/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
